        "\"\"\"\n",
        "Framing Content Analysis as Machine Learning Tasks\n",
        "==================================================\n",
        "Demonstrates how to frame qualitative content coding/text analysis\n",
        "into machine learning problems (Classification & Topic Modeling).\n",
        "\"\"\"\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer, CountVectorizer\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.naive_bayes import MultinomialNB\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.decomposition import LatentDirichletAllocation\n",
        "from sklearn.metrics import classification_report, accuracy_score\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 1. Dataset Formulation (Content Analysis Coding Scheme)\n",
        "# ---------------------------------------------------------------------------\n",
        "# In content analysis, human coders label text documents according to a codebook.\n",
        "# Here, documents represent news/reviews, with 'Topic' (Frame) and 'Sentiment' labels.\n",
        "\n",
        "raw_data = [\n",
        "    (\"The government announced a new economic stimulus package to support small businesses.\", \"Policy/Economy\", \"Positive\"),\n",
        "    (\"Inflation rates soared this quarter, putting heavy pressure on household budgets.\", \"Policy/Economy\", \"Negative\"),\n",
        "    (\"The central bank raised interest rates to stabilize volatile currency markets.\", \"Policy/Economy\", \"Neutral\"),\n",
        "    (\"New clean energy regulations will help reduce greenhouse gas emissions nationwide.\", \"Environment\", \"Positive\"),\n",
        "    (\"Toxic chemical waste was discovered contaminating the local freshwater reservoir.\", \"Environment\", \"Negative\"),\n",
        "    (\"Scientists published a comprehensive climate assessment detailing rising ocean temperatures.\", \"Environment\", \"Neutral\"),\n",
        "    (\"The latest breakthrough in semiconductor hardware delivers 50% faster processing power.\", \"Technology\", \"Positive\"),\n",
        "    (\"Severe server outages and security vulnerabilities have disrupted major online services.\", \"Technology\", \"Negative\"),\n",
        "    (\"Researchers introduced an open-source framework for training lightweight language models.\", \"Technology\", \"Neutral\"),\n",
        "    (\"Hospital systems reported historic staffing shortages and worsening supply chain delays.\", \"Healthcare\", \"Negative\"),\n",
        "    (\"Clinical trials for the novel cancer therapy achieved unprecedented recovery rates.\", \"Healthcare\", \"Positive\"),\n",
        "    (\"Public health officials released updated nutrition guidelines for school programs.\", \"Healthcare\", \"Neutral\"),\n",
        "    (\"Consumer confidence improved substantially following continuous job growth figures.\", \"Policy/Economy\", \"Positive\"),\n",
        "    (\"Wildfires devastated thousands of acres of protected forest habitat this week.\", \"Environment\", \"Negative\"),\n",
        "    (\"Engineers successfully deployed the new fiber optic communication infrastructure.\", \"Technology\", \"Positive\"),\n",
        "    (\"Medical clinics adopted telemedicine tools to expand outpatient consultation capacity.\", \"Healthcare\", \"Positive\")\n",
        "]\n",
        "\n",
        "df = pd.DataFrame(raw_data, columns=[\"text\", \"topic_code\", \"sentiment_code\"])\n",
        "print(\"=== Sample Labeled Dataset ===\")\n",
        "print(df.head(), \"\\n\")\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 2. Task 1: Framing Content Analysis as Supervised Multiclass Classification\n",
        "#    Goal: Predict the semantic topic/frame assigned to text\n",
        "# ---------------------------------------------------------------------------\n",
        "print(\"=\" * 60)\n",
        "print(\"TASK 1: Automated Topic/Frame Classification\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "X = df[\"text\"]\n",
        "y_topic = df[\"topic_code\"]\n",
        "\n",
        "# Train/Test Split (stratified to maintain label distribution)\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y_topic, test_size=0.25, random_state=42, stratify=y_topic\n",
        ")\n",
        "\n",
        "# Pipeline: TF-IDF Feature Extraction + Multinomial Naive Bayes / Logistic Regression\n",
        "topic_pipeline = Pipeline([\n",
        "    (\"tfidf\", TfidfVectorizer(ngram_range=(1, 2), stop_words=\"english\")),\n",
        "    (\"classifier\", LogisticRegression(solver=\"liblinear\", random_state=42))\n",
        "])\n",
        "\n",
        "# Model Training\n",
        "topic_pipeline.fit(X_train, y_train)\n",
        "\n",
        "# Evaluation\n",
        "y_pred_topic = topic_pipeline.predict(X_test)\n",
        "print(f\"Test Accuracy: {accuracy_score(y_test, y_pred_topic):.2f}\\n\")\n",
        "print(\"Classification Report:\")\n",
        "print(classification_report(y_test, y_pred_topic, zero_division=0))\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 3. Task 2: Framing Content Analysis as Sentiment / Valence Coding\n",
        "#    Goal: Predict positive, neutral, or negative affective tone\n",
        "# ---------------------------------------------------------------------------\n",
        "print(\"=\" * 60)\n",
        "print(\"TASK 2: Sentiment / Valence Classification\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "y_sent = df[\"sentiment_code\"]\n",
        "X_train_s, X_test_s, y_train_s, y_test_s = train_test_split(\n",
        "    X, y_sent, test_size=0.25, random_state=42, stratify=y_sent\n",
        ")\n",
        "\n",
        "sentiment_pipeline = Pipeline([\n",
        "    (\"tfidf\", TfidfVectorizer(ngram_range=(1, 2), stop_words=\"english\")),\n",
        "    (\"classifier\", MultinomialNB(alpha=1.0))\n",
        "])\n",
        "\n",
        "sentiment_pipeline.fit(X_train_s, y_train_s)\n",
        "y_pred_sent = sentiment_pipeline.predict(X_test_s)\n",
        "print(f\"Sentiment Accuracy: {accuracy_score(y_test_s, y_pred_sent):.2f}\\n\")\n",
        "print(classification_report(y_test_s, y_pred_sent, zero_division=0))\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 4. Task 3: Unsupervised Content Discovery (Topic Modeling via LDA)\n",
        "#    Goal: Extract latent thematic categories without manual pre-coding\n",
        "# ---------------------------------------------------------------------------\n",
        "print(\"=\" * 60)\n",
        "print(\"TASK 3: Unsupervised Theme Discovery (Latent Dirichlet Allocation)\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "count_vec = CountVectorizer(stop_words=\"english\", max_df=0.9, min_df=1)\n",
        "doc_term_matrix = count_vec.fit_transform(df[\"text\"])\n",
        "\n",
        "num_topics = 4\n",
        "lda_model = LatentDirichletAllocation(n_components=num_topics, random_state=42)\n",
        "lda_model.fit(doc_term_matrix)\n",
        "\n",
        "feature_names = count_vec.get_feature_names_out()\n",
        "for topic_idx, topic in enumerate(lda_model.components_):\n",
        "    top_words = [feature_names[i] for i in topic.argsort()[:-6:-1]]\n",
        "    print(f\"Discovered Theme #{topic_idx + 1}: {' | '.join(top_words)}\")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 5. Out-of-Sample Prediction & Content Analysis Inference\n",
        "# ---------------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"INFERENCE: Automated Coding of Unseen Texts\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "unseen_texts = [\n",
        "    \"The central bank lowered benchmark borrowing costs to boost commercial spending.\",\n",
        "    \"Researchers developed a rapid solar cell with zero emissions output.\",\n",
        "    \"A catastrophic server crash knocked out enterprise databases across the region.\"\n",
        "]\n",
        "\n",
        "pred_topics = topic_pipeline.predict(unseen_texts)\n",
        "pred_sentiments = sentiment_pipeline.predict(unseen_texts)\n",
        "\n",
        "for text, top, sent in zip(unseen_texts, pred_topics, pred_sentiments):\n",
        "    print(f\"Document : \\\"{text}\\\"\")\n",
        "    print(f\"  -> Predicted Topic/Frame: {top}\")\n",
        "    print(f\"  -> Predicted Sentiment  : {sent}\\n\")"
      ]
    }
  ]
