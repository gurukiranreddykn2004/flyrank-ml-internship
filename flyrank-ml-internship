      "source": [
        "import os\n",
        "from pathlib import Path\n",
        "\n",
        "target_file = 'content_refresh_anonymized.csv'\n",
        "current_dir = Path.cwd()\n",
        "print(f\"Current Working Directory: {current_dir}\")\n",
        "\n",
        "# Searching from parent directory automatically covers current directory and its children\n",
        "found = []\n",
        "for root, _, files in os.walk(current_dir.parent):\n",
        "    if target_file in files:\n",
        "        full_path = os.path.join(root, target_file)\n",
        "        print(f\"Found file at: {full_path}\")\n",
        "        found.append(full_path)\n",
        "\n",
        "if not found:\n",
        "    print(f\"'{target_file}' was not found in {current_dir.parent} or any subdirectories.\")"
      ],
