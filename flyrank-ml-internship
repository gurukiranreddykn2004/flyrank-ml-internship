        "import gradio as gr\n",
        "import re\n",
        "\n",
        "# ==============================================================================\n",
        "# BACKEND LOGIC: SEO & Readability Analyzer (Runs on the server when submitted)\n",
        "# ==============================================================================\n",
        "def analyze_content(target_keyword: str, draft_text: str) -> tuple[str, str]:\n",
        "    if not draft_text or not draft_text.strip():\n",
        "        return \"⚠️ Please enter some content text to analyze.\", \"0 / 100\"\n",
        "\n",
        "    # 1. Clean and tokenize text\n",
        "    words = re.findall(r\"\\b\\w+\\b\", draft_text.lower())\n",
        "    sentences = [s.strip() for s in re.split(r\"[.!?]+\", draft_text) if s.strip()]\n",
        "\n",
        "    word_count = len(words)\n",
        "    sentence_count = max(len(sentences), 1)\n",
        "    avg_sentence_len = round(word_count / sentence_count, 1)\n",
        "\n",
        "    # 2. Keyword density calculation\n",
        "    kw = target_keyword.strip().lower()\n",
        "    kw_count = draft_text.lower().count(kw) if kw else 0\n",
        "    kw_density = round((kw_count / max(word_count, 1)) * 100, 2) if kw else 0.0\n",
        "\n",
        "    # 3. Rule-based scoring (0 to 100)\n",
        "    score = 40\n",
        "    feedback = []\n",
        "\n",
        "    if word_count >= 150:\n",
        "        score += 20\n",
        "        feedback.append(f\"✅ Good depth ({word_count} words).\")\n",
        "    else:\n",
        "        feedback.append(f\"⚠️ Short draft ({word_count} words) — aim for 150+ words.\")\n",
        "\n",
        "    if 10 <= avg_sentence_len <= 22:\n",
        "        score += 20\n",
        "        feedback.append(f\"✅ Clear sentence length (avg {avg_sentence_len} words/sentence).\")\n",
        "    else:\n",
        "        feedback.append(f\"⚠️ Sentence length is {avg_sentence_len} words — aim for 10–22 words for readability.\")\n",
        "\n",
        "    if kw:\n",
        "        if 0.5 <= kw_density <= 2.5:\n",
        "            score += 20\n",
        "            feedback.append(f\"✅ Healthy keyword density for '{target_keyword}' ({kw_density}%).\")\n",
        "        elif kw_count == 0:\n",
        "            feedback.append(f\"❌ Target keyword '{target_keyword}' not found in draft.\")\n",
        "        else:\n",
        "            score += 10\n",
        "            feedback.append(f\"⚠️ Keyword '{target_keyword}' density is {kw_density}% (ideal: 0.5%–2.5%).\")\n",
        "    else:\n",
        "        feedback.append(\"ℹ️ No target keyword provided.\")\n",
        "\n",
        "    summary_report = (\n",
        "        f\"### Audit Breakdown\\n\"\n",
        "        f\"- **Word Count:** {word_count}\\n\"\n",
        "        f\"- **Sentences:** {sentence_count} (Avg {avg_sentence_len} words)\\n\"\n",
        "        f\"- **Keyword Matches:** {kw_count} ({kw_density}%)\\n\\n\"\n",
        "        f\"### Recommendations\\n\" + \"\\n\".join(f\"- {item}\" for item in feedback)\n",
        "    )\n",
        "\n",
        "    return summary_report, f\"{min(score, 100)} / 100\"\n",
        "\n",
        "# ==============================================================================\n",
        "# FRONTEND UI: Gradio Web Interface\n",
        "# ==============================================================================\n",
        "demo = gr.Interface(\n",
        "    fn=analyze_content,\n",
        "    inputs=[\n",
        "        gr.Textbox(label=\"Target SEO Keyword\", placeholder=\"e.g., machine learning\"),\n",
        "        gr.Textbox(label=\"Draft Content\", lines=6, placeholder=\"Paste a paragraph of your blog post or landing page here...\")\n",
        "    ],\n",
        "    outputs=[\n",
        "        gr.Markdown(label=\"Live Audit Report\"),\n",
        "        gr.Textbox(label=\"Content Readiness Score\")\n",
        "    ],\n",
        "    title=\"Live Content & SEO Readiness Analyzer\",\n",
        "    description=\"Enter a target keyword and draft text to run a real-time backend audit.\",\n",
        "    examples=[\n",
        "        [\n",
        "            \"machine learning\",\n",
        "            \"Machine learning models rely on clean, well-structured data to make reliable predictions. \"\n",
        "            \"When evaluating performance, engineers must prevent data leakage by separating training and validation sets properly. \"\n",
        "            \"Careful validation turns experimental code into trustworthy decision-support tools.\"\n",
        "        ]\n",
        "    ]\n",
        ")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    demo.launch()"
      ]
