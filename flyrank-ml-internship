        "import os\n",
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "\n",
        "target_filename = \"content_refresh_anonymized.csv\"\n",
        "\n",
        "# 1. Print current working directory\n",
        "current_dir = Path.cwd()\n",
        "print(f\"Current working directory: {current_dir}\")\n",
        "\n",
        "# 2. Search common candidate relative paths\n",
        "candidates = [\n",
        "    Path(\"data/raw\") / target_filename,\n",
        "    Path(\"../../data/raw\") / target_filename,\n",
        "    Path(\"../data/raw\") / target_filename,\n",
        "    Path(\"../../../data/raw\") / target_filename,\n",
        "]\n",
        "\n",
        "file_path = None\n",
        "for p in candidates:\n",
        "    if p.resolve().exists():\n",
        "        file_path = p.resolve()\n",
        "        break\n",
        "\n",
        "# 3. Fallback: Search the repository tree upward\n",
        "if not file_path:\n",
        "    for parent in [current_dir] + list(current_dir.parents):\n",
        "        matches = list(parent.glob(f\"**/{target_filename}\"))\n",
        "        if matches:\n",
        "            file_path = matches[0]\n",
        "            break\n",
        "\n",
        "# 4. Load or report findings\n",
        "if file_path and file_path.exists():\n",
        "    print(f\"Found file at: {file_path}\")\n",
        "    df = pd.read_csv(file_path)\n",
        "    print(f\"Loaded dataset: {df.shape[0]} rows, {df.shape[1]} columns\")\n",
        "else:\n",
        "    print(f\"Could not find '{target_filename}' automatically.\")\n",
        "    print(\"Files and folders in current directory:\", os.listdir(current_dir))\n",
        "    if (current_dir.parent).exists():\n",
        "        print(\"Files and folders in parent directory:\", os.listdir(current_dir.parent))"
