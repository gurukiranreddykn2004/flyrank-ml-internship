        "import os\n",
        "import subprocess\n",
        "import pandas as pd\n",
        "\n",
        "# If data is not in the current directory, clone the repo files into Colab\n",
        "csv_path = \"data/raw/content_refresh_anonymized.csv\"\n",
        "\n",
        "if not os.path.exists(csv_path):\n",
        "    repo_dir = \"flyrank-ml-internship-starter\"\n",
        "    repo_url = \"https://github.com/flyrank-bih/flyrank-ml-internship-starter\"\n",
        "    if not os.path.isdir(repo_dir):\n",
        "        subprocess.run([\"git\", \"clone\", \"--depth\", \"1\", repo_url, repo_dir], check=True)\n",
        "    if os.path.exists(f\"{repo_dir}/{csv_path}\"):\n",
        "        csv_path = f\"{repo_dir}/{csv_path}\"\n",
        "\n",
        "# Load the dataset\n",
        "df = pd.read_csv(csv_path)\n",
        "\n",
        "total_pages = len(df)\n",
        "declining_pages = (df[\"trend_direction\"] == \"down\").sum()\n",
        "decline_pct = (declining_pages / total_pages) * 100\n",
        "corr_volume_imp = df[\"search_volume\"].corr(df[\"impressions_90d\"])\n",
        "median_imp_down = df[df[\"trend_direction\"] == \"down\"][\"impressions_90d\"].median()\n",
        "median_imp_up = df[df[\"trend_direction\"] == \"up\"][\"impressions_90d\"].median()\n",
        "\n",
        "print(f\"Total pages: {total_pages:,}\")\n",
        "print(f\"Declining pages: {declining_pages:,} ({decline_pct:.1f}% baseline rate)\")\n",
        "print(f\"Correlation between search_volume and impressions_90d: {corr_volume_imp:.3f}\")\n",
        "print(f\"Median impressions - Declining: {median_imp_down:.0f} vs Growing: {median_imp_up:.0f}\")"
      ]
    }
  ]
